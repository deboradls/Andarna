# Servidor e frontend
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/andarna

# Gere uma chave longa e aleatória para produção.
JWT_SECRET=troque-esta-chave-por-uma-chave-segura

# Credenciais criadas em Google Cloud Console > APIs e serviços > Credenciais
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Opcional, mas recomendado para maior cota da API Google Books.
GOOGLE_BOOKS_API_KEY=
